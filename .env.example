# OpenRouter key (https://openrouter.ai/keys). Without it the advisor answers from a template
# and recorded answers are replayed.
OPENROUTER_API_KEY=

# Model id on OpenRouter. Free models end with ":free"; paid ones need ALLOW_PAID_MODELS=1.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Reasoning models think before answering: low leaves room for the answer.
LLM_REASONING_EFFORT=low
ALLOW_PAID_MODELS=0

# Any OpenAI-compatible endpoint instead of OpenRouter (Ollama, OpenAI, Groq...).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# 0 = never write recordings (read-only deployments)
LLM_CACHE_WRITE=1

HOST=127.0.0.1
PORT=4310

# Posts per extraction call; small local models do better with 2.
# EXTRACT_BATCH=8

# Behind a reverse proxy: take the client address from X-Forwarded-For.
# TRUST_PROXY=1
