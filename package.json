{
  "name": "lensmap-ai-demo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Grounded city advisor and LLM event extraction, extracted from the LensMap app",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fetch-city": "tsx scripts/fetch-city.ts",
    "record": "tsx scripts/record.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "opening_hours": "^3.14.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
